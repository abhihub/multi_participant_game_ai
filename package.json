{
  "name": "multiplayer-ai-games-api",
  "version": "1.3.0",
  "description": "Backend API for multiplayer AI-moderated games (trivia, quick draw) over LiveKit",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.24.2",
    "livekit-server-sdk": "^2.9.1",
    "nanoid": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "eslint": "^9.20.0",
    "@eslint/js": "^9.20.0",
    "typescript-eslint": "^8.24.1",
    "prettier": "^3.5.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
